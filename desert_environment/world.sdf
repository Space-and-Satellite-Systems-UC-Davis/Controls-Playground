<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='desert'>
    <static>true</static>
    <link name='link'>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>/workspace/desert_environment/DesertGZ2.obj</uri>
            <scale>10 10 10</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>/workspace/desert_environment/DesertGZ2.obj</uri>
            <scale>10 10 10</scale>
