{
  "name": "Perception-Playground (ROS 2 Jazzy + Nav2)",
  "image": "ghcr.io/space-and-satellite-systems-uc-davis/ros-container:jazzy",
  "forwardPorts": [
    6080,
    5901
  ],
  "portsAttributes": {
    "6080": {
      "label": "noVNC",
      "onAutoForward": "notify"
    }
  },
  "runArgs": [
    "--device=${localEnv:GPU_DEVICE:/dev/dxg}",
    "--network=host",
    "--ipc=host"
  ],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=/usr/lib/wsl,target=/usr/lib/wsl,type=bind,ro",
    "source=\\\\wsl.localhost\\${localEnv:GZ_WSL_DISTRO:Ubuntu}\\tmp\\.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=\\\\wsl.localhost\\${localEnv:GZ_WSL_DISTRO:Ubuntu}\\mnt\\wslg,target=/mnt/wslg,type=bind"
  ],
  "containerEnv": {
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "PULSE_SERVER": "unix:/mnt/wslg/PulseServer",
    "QT_X11_NO_MITSHM": "1",
    "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
    "GALLIUM_DRIVER": "${localEnv:GZ_GALLIUM_DRIVER:d3d12}",
    "LIBGL_ALWAYS_SOFTWARE": "0"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python"
      ]
    }
  },
  "workspaceFolder": "/workspace",
  "postStartCommand": [
    "bash",
    ".devcontainer/scripts/post-start.sh"
  ]
}
